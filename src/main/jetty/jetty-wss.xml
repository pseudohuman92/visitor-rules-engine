<?xml version="1.0" encoding="UTF-8"?>
<Configure id="Server" class="org.eclipse.jetty.server.Server">
    <New id="httpsConfig" class="org.eclipse.jetty.server.HttpConfiguration">
        <Set name="secureScheme">https</Set>
        <Set name="securePort">
            <Property name="jetty.ssl.port" default="8443"/>
        </Set>
        <Call name="addCustomizer">
            <Arg>
                <New class="org.eclipse.jetty.server.SecureRequestCustomizer"/>
            </Arg>
        </Call>
    </New>
    <Call name="addConnector">
        <Arg>
            <New class="org.eclipse.jetty.server.ServerConnector">
                <Arg name="server">
                    <Ref refid="Server"/>
                </Arg>
                <Arg name="factories">
                    <Array type="org.eclipse.jetty.server.ConnectionFactory">
                        <Item>
                            <New class="org.eclipse.jetty.server.SslConnectionFactory">
                                <Arg name="sslContextFactory">
                                    <New class="org.eclipse.jetty.util.ssl.SslContextFactory$Server">
                                        <Set name="KeyStorePath">
                                            <Property name="jetty.ssl.keystore"/>
                                        </Set>
                                        <Set name="KeyStorePassword">
                                            <Property name="jetty.ssl.password"/>
                                        </Set>
                                        <Set name="KeyStoreType">
                                            <Property name="jetty.ssl.keyStoreType" default="PKCS12"/>
                                        </Set>
                                    </New>
                                </Arg>
                                <Arg name="next">http/1.1</Arg>
                            </New>
                        </Item>
                        <Item>
                            <New class="org.eclipse.jetty.server.HttpConnectionFactory">
                                <Arg>
                                    <Ref refid="httpsConfig"/>
                                </Arg>
                            </New>
                        </Item>
                    </Array>
                </Arg>
                <Set name="port">
                    <Property name="jetty.ssl.port" default="8443"/>
                </Set>
            </New>
        </Arg>
    </Call>
</Configure>
